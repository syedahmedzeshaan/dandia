PORT=3000
NODE_ENV=development
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_WORKSHEET_NAME=Form Responses 1
GOOGLE_DRIVE_FOLDER_ID=your_private_drive_folder_id
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# Optional locally; required on Render after the one-time OAuth connection.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Set to your production URL, e.g. https://mvsrec-dandiya-admin.onrender.com
APP_BASE_URL=
# Required on Render. Use a long, unique password shared only with the two admins.
ADMIN_USERNAME=
ADMIN_PASSWORD=
MAX_UPLOAD_SIZE_MB=5
